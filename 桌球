}

/* =====================================================================
   八、绘制
   ===================================================================== */
let SCALE = 1;                             // 逻辑坐标 → 画布像素的缩放
const tableLayer = document.createElement('canvas');   // 静态球桌只画一次，之后每帧直接贴图

function mulberry32(a){                    // 固定种子的随机数，保证木纹每次都一样
  return function(){ a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; };
}
function roundRect(c, x, y, w, h, r){
  c.beginPath(); c.moveTo(x + r, y); c.lineTo(x + w - r, y); c.quadraticCurveTo(x + w, y, x + w, y + r);
  c.lineTo(x + w, y + h - r); c.quadraticCurveTo(x + w, y + h, x + w - r, y + h); c.lineTo(x + r, y + h);
  c.quadraticCurveTo(x, y + h, x, y + h - r); c.lineTo(x, y + r); c.quadraticCurveTo(x, y, x + r, y); c.closePath();
}
function polyPath(c, pts){
  c.beginPath(); c.moveTo(pts[0][0], pts[0][1]);
  for (let i = 1; i < pts.length; i++) c.lineTo(pts[i][0], pts[i][1]);
  c.closePath();
}

function buildTable(){
  tableLayer.width = canvas.width; tableLayer.height = canvas.height;
  const c = tableLayer.getContext('2d'), rnd = mulberry32(20240607);
  c.setTransform(SCALE, 0, 0, SCALE, 0, 0);
  c.clearRect(0, 0, VW, VH);

  // 棕色木质边框 + 木纹
  let g = c.createLinearGradient(0, 0, 0, VH);
  g.addColorStop(0, '#7c4b25'); g.addColorStop(0.5, '#5f3718'); g.addColorStop(1, '#482810');
  roundRect(c, 0, 0, VW, VH, 26); c.fillStyle = g; c.fill();
  c.save(); roundRect(c, 0, 0, VW, VH, 26); c.clip();
  for (let i = 0; i < 170; i++){
    const y = rnd() * VH, w = rnd() * 1.3 + 0.3;
    c.strokeStyle = rnd() < 0.5 ? 'rgba(30,14,4,' + (0.06 + rnd() * 0.12) + ')' : 'rgba(255,205,150,' + (0.03 + rnd() * 0.06) + ')';
    c.lineWidth = w; c.beginPath(); c.moveTo(-10, y);
    c.bezierCurveTo(VW * 0.3, y + (rnd() - 0.5) * 14, VW * 0.7, y + (rnd() - 0.5) * 14, VW + 10, y + (rnd() - 0.5) * 8); c.stroke();
  }
  c.restore();
  c.lineWidth = 2; c.strokeStyle = 'rgba(255,220,170,.22)'; roundRect(c, 1.5, 1.5, VW - 3, VH - 3, 25); c.stroke();
  c.strokeStyle = 'rgba(0,0,0,.45)'; roundRect(c, 0.5, 0.5, VW - 1, VH - 1, 26); c.stroke();

  // 绿色呢绒台面
  const bx = RAIL, by = RAIL, bw = VW - 2 * RAIL, bh = VH - 2 * RAIL;
  g = c.createRadialGradient(CX, CY - 30, 40, CX, CY, 540);
  g.addColorStop(0, '#23a062'); g.addColorStop(0.55, '#178049'); g.addColorStop(1, '#0f6338');
  c.fillStyle = g; roundRect(c, bx, by, bw, bh, 5); c.fill();
  c.save(); roundRect(c, bx, by, bw, bh, 5); c.clip();
  for (let i = 0; i < 9000; i++){                                // 呢绒的细小颗粒
    c.fillStyle = rnd() < 0.5 ? 'rgba(255,255,255,.035)' : 'rgba(0,0,0,.05)';
    c.fillRect(bx + rnd() * bw, by + rnd() * bh, 1.2, 1.2);
  }
  // 开球线、置球点
  c.strokeStyle = 'rgba(255,255,255,.13)'; c.lineWidth = 1; c.beginPath(); c.moveTo(HEAD_X, T); c.lineTo(HEAD_X, B); c.stroke();
  c.fillStyle = 'rgba(255,255,255,.28)';
  c.beginPath(); c.arc(HEAD_X, CY, 2.2, 0, Math.PI * 2); c.fill();
  c.beginPath(); c.arc(FOOT_X, CY, 2.2, 0, Math.PI * 2); c.fill();
  // 库边在台面上的投影
  c.shadowColor = 'rgba(0,0,0,.55)'; c.shadowBlur = 9 * SCALE; c.shadowOffsetX = 2 * SCALE; c.shadowOffsetY = 3 * SCALE;
  c.fillStyle = '#0d5a33';
  CUSHIONS.forEach(function(p){ polyPath(c, p); c.fill(); });
  c.shadowColor = 'transparent'; c.shadowBlur = 0; c.shadowOffsetX = 0; c.shadowOffsetY = 0;
  // 库边本体：鼻线一侧亮，靠木框一侧暗
  CUSHIONS.forEach(function(p, i){
    const horizontal = i < 4, top = i === 0 || i === 1, left = i === 4;
    let gg;
    if (horizontal) gg = top ? c.createLinearGradient(0, T - CUSH, 0, T) : c.createLinearGradient(0, B + CUSH, 0, B);
    else gg = left ? c.createLinearGradient(L - CUSH, 0, L, 0) : c.createLinearGradient(R + CUSH, 0, R, 0);
    gg.addColorStop(0, '#0b4d2c'); gg.addColorStop(0.7, '#15794a'); gg.addColorStop(1, '#1f9459');
    polyPath(c, p); c.fillStyle = gg; c.fill();
    c.strokeStyle = 'rgba(255,255,255,.2)'; c.lineWidth = 1;
    c.beginPath(); c.moveTo(p[1][0], p[1][1]); c.lineTo(p[2][0], p[2][1]); c.stroke();
  });
  c.restore();
  c.strokeStyle = 'rgba(0,0,0,.5)'; c.lineWidth = 2; roundRect(c, bx, by, bw, bh, 5); c.stroke();
  c.strokeStyle = 'rgba(255,215,160,.16)'; c.lineWidth = 1; roundRect(c, bx - 1.5, by - 1.5, bw + 3, bh + 3, 6); c.stroke();

  // 球袋：皮质袋口 + 黑色洞口
  POCKETS.forEach(function(pk){
    g = c.createRadialGradient(pk.x, pk.y, pk.r - 2, pk.x, pk.y, pk.r + 6);
    g.addColorStop(0, '#120b05'); g.addColorStop(0.6, '#3a2412'); g.addColorStop(1, '#22150a');
    c.fillStyle = g; c.beginPath(); c.arc(pk.x, pk.y, pk.r + 5, 0, Math.PI * 2); c.fill();
    g = c.createRadialGradient(pk.x - 3, pk.y - 3, 2, pk.x, pk.y, pk.r);
    g.addColorStop(0, '#000'); g.addColorStop(0.75, '#050505'); g.addColorStop(1, '#161616');
    c.fillStyle = g; c.beginPath(); c.arc(pk.x, pk.y, pk.r, 0, Math.PI * 2); c.fill();
    c.strokeStyle = 'rgba(255,225,180,.16)'; c.lineWidth = 1; c.beginPath(); c.arc(pk.x, pk.y, pk.r + 5, 0, Math.PI * 2); c.stroke();
  });

  // 木框上的菱形瞄准标记
  c.fillStyle = 'rgba(246,236,214,.85)';
  function diamond(x, y){ c.beginPath(); c.moveTo(x, y - 4.5); c.lineTo(x + 3, y); c.lineTo(x, y + 4.5); c.lineTo(x - 3, y); c.closePath(); c.fill(); }
  for (let i = 1; i < 8; i++){ if (i === 4) continue; const x = L + FW * i / 8; diamond(x, RAIL / 2); diamond(x, VH - RAIL / 2); }
  for (let i = 1; i < 4; i++){ const y = T + FH * i / 4; diamond(RAIL / 2, y); diamond(VW - RAIL / 2, y); }
}

/* 球的投影贴图 */
const shadowSpr = document.createElement('canvas');
(function(){
  shadowSpr.width = shadowSpr.height = 64;
  const c = shadowSpr.getContext('2d'), g = c.createRadialGradient(32, 32, 6, 32, 32, 32);
  g.addColorStop(0, 'rgba(0,0,0,.6)'); g.addColorStop(0.55, 'rgba(0,0,0,.28)'); g.addColorStop(1, 'rgba(0,0,0,0)');
  c.fillStyle = g; c.fillRect(0, 0, 64, 64);
})();
const BALL_DRAW = DIAM * (SPR / 2) / SPR_R;    // 贴图绘制到逻辑坐标的边长

function drawBall(b, x, y, scale, alpha){
  if (b.dirty) renderSprite(b);
  const s = BALL_DRAW * scale;
  ctx.globalAlpha = alpha;
  ctx.drawImage(b.spr, x - s / 2, y - s / 2, s, s);
  ctx.globalAlpha = 1;
}
function powerColor(p){ return 'hsl(' + Math.round(130 - 130 * p) + ',88%,56%)'; }

/* 球杆：tip 端距白球球心 off，沿击球方向的反方向延伸 */
function drawStick(x, y, dx, dy, off, alpha){
  ctx.save();
  ctx.globalAlpha = alpha;
  ctx.translate(x, y); ctx.rotate(Math.atan2(-dy, -dx));       // 旋转后 +x 轴指向球杆尾部
  const len = 350, a = off, b = off + len;
  // 球杆投影：屏幕上固定向右下偏移 (3,5)，这里换算到球杆自身的坐标系（-dx,-dy 即球杆朝向的 cos/sin）
  const ox = -3 * dx - 5 * dy, oy = 3 * dy - 5 * dx;
  ctx.fillStyle = 'rgba(0,0,0,.28)';
  ctx.beginPath(); ctx.moveTo(a + ox, -2.6 + oy); ctx.lineTo(b + ox, -4.8 + oy); ctx.lineTo(b + ox, 4.8 + oy); ctx.lineTo(a + ox, 2.6 + oy); ctx.closePath(); ctx.fill();
  const g = ctx.createLinearGradient(0, -5, 0, 5);
  g.addColorStop(0, '#f3dcab'); g.addColorStop(0.5, '#d9b574'); g.addColorStop(1, '#a8823f');
  ctx.fillStyle = g;                                            // 前节（枫木）
  ctx.beginPath(); ctx.moveTo(a + 12, -2.7); ctx.lineTo(a + 215, -3.9); ctx.lineTo(a + 215, 3.9); ctx.lineTo(a + 12, 2.7); ctx.closePath(); ctx.fill();
  const g2 = ctx.createLinearGradient(0, -5, 0, 5);
  g2.addColorStop(0, '#5a3a22'); g2.addColorStop(0.5, '#2c1a0e'); g2.addColorStop(1, '#120a05');
  ctx.fillStyle = g2;                                           // 后节（深色握把）
  ctx.beginPath(); ctx.moveTo(a + 215, -3.9); ctx.lineTo(b, -4.8); ctx.lineTo(b, 4.8); ctx.lineTo(a + 215, 3.9); ctx.closePath(); ctx.fill();
  ctx.fillStyle = '#c9a24a'; ctx.fillRect(a + 213, -4, 3, 8);   // 铜箍
  ctx.fillStyle = '#f4f1e8'; ctx.fillRect(a + 4, -2.7, 8, 5.4); // 先角
  ctx.fillStyle = '#3d7fc4'; ctx.fillRect(a, -2.5, 4, 5);       // 皮头（巧粉蓝）
  ctx.restore();
}

/* 瞄准预测：从白球沿击球方向发出射线，求最先碰到的球或库边。
   射线与“半径为 2r 的圆”求交，得到碰撞瞬间白球球心的位置（幽灵球） */
function castAim(ox, oy, dx, dy){
  let best = Infinity, hit = null;
  for (let i = 0; i < G.balls.length; i++){
    const b = G.balls[i];
    if (b.potted || b.num === 0) continue;
    const fx = b.x - ox, fy = b.y - oy, proj = fx * dx + fy * dy;       // 球心在射线方向上的投影长度
    if (proj <= 0) continue;
    const perp2 = fx * fx + fy * fy - proj * proj;                      // 球心到射线的垂直距离的平方
    if (perp2 >= DIAM2) continue;
    const t = proj - Math.sqrt(DIAM2 - perp2);
    if (t < best){ best = t; hit = b; }
  }
  let tw = Infinity, axis = '';
  if (dx > 0){ const t = (R - BR - ox) / dx; if (t < tw){ tw = t; axis = 'x'; } }
  if (dx < 0){ const t = (L + BR - ox) / dx; if (t < tw){ tw = t; axis = 'x'; } }
  if (dy > 0){ const t = (B - BR - oy) / dy; if (t < tw){ tw = t; axis = 'y'; } }
  if (dy < 0){ const t = (T + BR - oy) / dy; if (t < tw){ tw = t; axis = 'y'; } }
  if (hit && best <= tw) return { t: Math.max(0, best), ball: hit, axis: '', gx: ox + dx * best, gy: oy + dy * best };
  tw = Math.max(0, tw);
  return { t: tw, ball: null, axis: axis, gx: ox + dx * tw, gy: oy + dy * tw };
}

function drawAim(){
  const a = aimInfo();
  if (!a) return;
  const c = G.cue, col = powerColor(a.power);
  // 蓄力线（弹弓线）：白球 → 鼠标，线越长力度越大
  ctx.save();
  ctx.lineCap = 'round';
  ctx.strokeStyle = col; ctx.globalAlpha = 0.5; ctx.lineWidth = 2;
  ctx.beginPath(); ctx.moveTo(c.x, c.y); ctx.lineTo(G.drag.x, G.drag.y); ctx.stroke();
  ctx.globalAlpha = 0.9; ctx.fillStyle = col; ctx.beginPath(); ctx.arc(G.drag.x, G.drag.y, 4, 0, Math.PI * 2); ctx.fill();
  ctx.globalAlpha = 1;
  if (a.power > 0){
    // 瞄准线：白球 → 幽灵球
    const h = castAim(c.x, c.y, a.dx, a.dy);
    ctx.strokeStyle = 'rgba(255,255,255,.85)'; ctx.lineWidth = 1.4; ctx.setLineDash([7, 6]);
    ctx.beginPath(); ctx.moveTo(c.x + a.dx * BR, c.y + a.dy * BR); ctx.lineTo(h.gx, h.gy); ctx.stroke();
    ctx.setLineDash([]);
    ctx.strokeStyle = 'rgba(255,255,255,.8)'; ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.arc(h.gx, h.gy, BR - 0.6, 0, Math.PI * 2); ctx.stroke();
    if (h.ball){
      // 目标球沿两球连心线方向前进；白球沿切线方向偏出
      const nx = (h.ball.x - h.gx) / DIAM, ny = (h.ball.y - h.gy) / DIAM, dot = a.dx * nx + a.dy * ny;
      const len = 36 + 90 * a.power * dot;
      ctx.strokeStyle = 'rgba(255,214,90,.9)'; ctx.lineWidth = 1.6;
      ctx.beginPath(); ctx.moveTo(h.ball.x + nx * BR, h.ball.y + ny * BR); ctx.lineTo(h.ball.x + nx * (BR + len), h.ball.y + ny * (BR + len)); ctx.stroke();
      let tx = a.dx - dot * nx, ty = a.dy - dot * ny;
      const tl = Math.hypot(tx, ty);
      if (tl > 0.02){
        tx /= tl; ty /= tl;
        const l2 = 14 + 50 * a.power * tl;
        ctx.strokeStyle = 'rgba(255,255,255,.5)'; ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.moveTo(h.gx + tx * BR, h.gy + ty * BR); ctx.lineTo(h.gx + tx * (BR + l2), h.gy + ty * (BR + l2)); ctx.stroke();
      }
    } else {
      // 碰库后的反弹方向
      const rx = h.axis === 'x' ? -a.dx : a.dx, ry = h.axis === 'y' ? -a.dy : a.dy;
      ctx.strokeStyle = 'rgba(255,255,255,.4)'; ctx.lineWidth = 1.2;
      ctx.beginPath(); ctx.moveTo(h.gx, h.gy); ctx.lineTo(h.gx + rx * 46, h.gy + ry * 46); ctx.stroke();
    }
    // 白球周围的力度环
    ctx.strokeStyle = col; ctx.lineWidth = 3;
    ctx.beginPath(); ctx.arc(c.x, c.y, BR + 5, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * a.power); ctx.stroke();
  }
  ctx.restore();
  drawStick(c.x, c.y, a.dx, a.dy, BR + 5 + a.power * 70, a.power > 0 ? 1 : 0.45);
}

function render(){
  ctx.setTransform(SCALE, 0, 0, SCALE, 0, 0);
  ctx.clearRect(0, 0, VW, VH);
  ctx.drawImage(tableLayer, 0, 0, VW, VH);
  const bs = G.balls, placing = G.phase === 'place';

  // 自由球摆放时提示可放区域（开球时只能放在开球线左侧）
  if (placing && G.kitchen){
    ctx.fillStyle = 'rgba(255,255,255,.06)'; ctx.fillRect(L, T, HEAD_X - L, FH);
  }
  // 投影
  for (let i = 0; i < bs.length; i++){
    const b = bs[i];
    if (b.potted) continue;
    const s = BR * 2.7;
    ctx.globalAlpha = (placing && b === G.cue) ? 0.5 : 1;
    ctx.drawImage(shadowSpr, b.x + 2.5 - s / 2, b.y + 4 - s / 2, s, s);
  }
  ctx.globalAlpha = 1;
  // 正在落袋的球：滑向袋心、缩小、淡出
  for (let i = 0; i < bs.length; i++){
    const b = bs[i];
    if (!b.sink) continue;
    const k = b.sink.t, e = 1 - (1 - k) * (1 - k);
    drawBall(b, b.sink.x0 + (b.sink.px - b.sink.x0) * e, b.sink.y0 + (b.sink.py - b.sink.y0) * e, 1 - 0.42 * k, 1 - k * k);
  }
  // 台面上的球
  for (let i = 0; i < bs.length; i++){
    const b = bs[i];
    if (b.potted) continue;
    drawBall(b, b.x, b.y, 1, (placing && b === G.cue) ? 0.82 : 1);
  }

  const c = G.cue;
  if (placing){
    ctx.strokeStyle = G.placeOK ? 'rgba(80,235,150,.95)' : 'rgba(255,90,70,.95)';
    ctx.lineWidth = 2; ctx.setLineDash([5, 4]);
    ctx.beginPath(); ctx.arc(c.x, c.y, BR + 5, 0, Math.PI * 2); ctx.stroke(); ctx.setLineDash([]);
  } else if (G.phase === 'aim'){
    if (G.drag) drawAim();
    else {
      // 待击球时白球周围的呼吸光圈，提示“按住这里拖拽”
      const pulse = 0.5 + 0.5 * Math.sin(G.time * 4);
      ctx.strokeStyle = 'rgba(255,255,255,' + (0.25 + 0.4 * pulse) + ')'; ctx.lineWidth = 1.6;
      ctx.beginPath(); ctx.arc(c.x, c.y, BR + 4 + 2.5 * pulse, 0, Math.PI * 2); ctx.stroke();
    }
  } else if (G.phase === 'strike'){
    const s = G.strike, k = Math.min(1, s.t / STRIKE_TIME);
    drawStick(c.x, c.y, s.dx, s.dy, s.from + (BR + 1 - s.from) * k * k, 1);        // 球杆加速送向白球
  }
  if (G.stickFade){
    const f = G.stickFade, k = f.t / 0.3;
    drawStick(f.x, f.y, f.dx, f.dy, BR + 1 - 8 * Math.min(1, k * 3), 1 - k);       // 击球后球杆略微前送并淡出
  }
}

/* =====================================================================
   九、输入（Pointer Events，同时支持鼠标和触屏）
   ===================================================================== */
function pointerPos(e){
  const r = canvas.getBoundingClientRect();
  return { x: (e.clientX - r.left) * VW / r.width, y: (e.clientY - r.top) * VH / r.height };
}
function nearCue(p){ return Math.hypot(p.x - G.cue.x, p.y - G.cue.y) <= GRAB_R; }
function movePlace(p){
  const maxX = G.kitchen ? HEAD_X : R - BR;
  G.cue.x = clamp(p.x, L + BR, maxX); G.cue.y = clamp(p.y, T + BR, B - BR);
  G.placeOK = validPlace(G.cue.x, G.cue.y);
}
function cancelDrag(){ if (G.drag){ G.drag = null; setPower(0); } }

canvas.addEventListener('pointerdown', function(e){
  if (e.button !== undefined && e.button !== 0) return;
  Sfx.init();
  const p = pointerPos(e);
  if (G.phase === 'place'){
    movePlace(p); G.placing = true;
    try { canvas.setPointerCapture(e.pointerId); } catch (err) { /* 个别浏览器不支持时忽略 */ }
  } else if (G.phase === 'aim' && nearCue(p)){
    G.drag = p; G.trim = 1;
    canvas.style.cursor = 'grabbing';
    try { canvas.setPointerCapture(e.pointerId); } catch (err) { /* 同上 */ }
  }
  e.preventDefault();
});
canvas.addEventListener('pointermove', function(e){
  const p = pointerPos(e);
  if (G.phase === 'place'){ movePlace(p); canvas.style.cursor = 'move'; return; }
  if (G.drag){
    G.drag = p;
    const a = aimInfo(); setPower(a ? a.power : 0);
    return;
  }
  canvas.style.cursor = (G.phase === 'aim' && nearCue(p)) ? 'grab' : 'default';
});
canvas.addEventListener('pointerup', function(e){
  if (G.phase === 'place'){
    if (G.placing && G.placeOK){ G.phase = 'aim'; canvas.style.cursor = 'grab'; updateHUD(); }
    G.placing = false;
    return;
  }
  if (G.drag && G.phase === 'aim'){ G.drag = pointerPos(e); releaseShot(); canvas.style.cursor = 'default'; }
});
canvas.addEventListener('pointercancel', function(){ cancelDrag(); G.placing = false; });
canvas.addEventListener('contextmenu', function(e){ e.preventDefault(); cancelDrag(); });
/* 拖拽时滚轮微调力度：可以拉得很远来精确瞄准，再用滚轮把力度降下来 */
canvas.addEventListener('wheel', function(e){
  if (!G.drag) return;
  e.preventDefault();
  G.trim = clamp(G.trim - (e.deltaY > 0 ? 0.05 : -0.05), 0.1, 1);
  const a = aimInfo(); setPower(a ? a.power : 0);
}, { passive: false });
/* 自由球（或开球）时双击白球可以重新摆放 */
canvas.addEventListener('dblclick', function(e){
  if (G.phase === 'aim' && G.ballInHand && nearCue(pointerPos(e))){
    G.drag = null; G.placing = false; G.phase = 'place'; G.placeOK = validPlace(G.cue.x, G.cue.y);
    setPower(0); updateHUD();
  }
});
window.addEventListener('keydown', function(e){ if (e.key === 'Escape') cancelDrag(); });

el.btnRestart.addEventListener('click', function(){ Sfx.init(); newGame(); });
el.btnAgain.addEventListener('click', function(){ Sfx.init(); newGame(); });
el.btnSound.addEventListener('click', function(){
  Sfx.enabled = !Sfx.enabled;
  el.btnSound.textContent = '音效：' + (Sfx.enabled ? '开' : '关');
  if (Sfx.enabled) Sfx.init();
});

/* 画布尺寸跟随容器宽度，并按设备像素比提高分辨率，保证高分屏上清晰 */
function resize(){
  const cssW = canvas.clientWidth || 800, dpr = Math.min(window.devicePixelRatio || 1, 2.5);
  const w = Math.max(320, Math.round(cssW * dpr)), h = Math.round(w * VH / VW);
  if (canvas.width === w && canvas.height === h) return;
  canvas.width = w; canvas.height = h;
  SCALE = w / VW;
  buildTable();
}
window.addEventListener('resize', resize);

/* =====================================================================
   十、游戏主循环
   requestAnimationFrame 让浏览器在每次屏幕刷新前回调 frame()。
   · 渲染：每帧一次。
   · 物理：与刷新率解耦。把这一帧经过的真实时间 dt 放进累加器 acc，
     再按固定步长 SUB_DT（1/480 秒）一小步一小步地消耗掉。
     这样无论 60Hz 还是 144Hz 屏幕，球的运动都完全一致；
     同时每步位移远小于球半径，高速球不会“穿过”别的球或库边。
   ===================================================================== */
function update(dt){
  G.time += dt;
  if (G.phase === 'strike'){
    G.strike.t += dt;
    if (G.strike.t >= STRIKE_TIME) fire();
  }
  if (G.phase === 'moving'){
    acc += dt;
    while (acc >= SUB_DT){ physicsStep(SUB_DT); acc -= SUB_DT; }
  }
  // 推进落袋动画
  let busy = false;
  for (let i = 0; i < G.balls.length; i++){
    const b = G.balls[i];
    if (b.sink){ b.sink.t += dt / 0.3; if (b.sink.t >= 1) b.sink = null; else busy = true; }
  }
  // 所有球都停下（且落袋动画播完）后稍等片刻，再结算这一杆
  if (G.phase === 'moving'){
    if (!busy){
      for (let i = 0; i < G.balls.length; i++){
        const b = G.balls[i];
        if (!b.potted && (b.vx !== 0 || b.vy !== 0)){ busy = true; break; }
      }
    }
    if (busy) G.settle = 0;
    else { G.settle += dt; if (G.settle > 0.3) resolveShot(); }
  }
  if (G.stickFade){ G.stickFade.t += dt; if (G.stickFade.t >= 0.3) G.stickFade = null; }
}

let lastTime = performance.now();
function frame(now){
  const dt = Math.min(0.05, Math.max(0, (now - lastTime) / 1000));   // 限制最大步长，切换标签页回来时不会“快进”
  lastTime = now;
  update(dt);
  render();
  requestAnimationFrame(frame);
}

resize();
newGame();
requestAnimationFrame(frame);
})();
</script>
